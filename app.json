{
  "expo": {
    "name": "ShopHop",
    "slug": "shopping-trip-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.james.shophop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#56e2ec"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b1f2a"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "295b5dd5-8c81-4df6-a581-44042770c7b1"
      }
    }
  }
}
